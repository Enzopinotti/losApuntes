# Public client configuration only. Never place secrets here.
# Production/preview builds require HTTPS.
EXPO_PUBLIC_LOSAPUNTES_API_URL=
EXPO_PUBLIC_LOSAPUNTES_ALLOW_INSECURE_HTTP=false

# Google OAuth public client IDs. Provider secrets never belong in Mobile.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# External release identities; do not invent these in source control.
LOSAPUNTES_MOBILE_IOS_BUNDLE_ID=
LOSAPUNTES_MOBILE_ANDROID_PACKAGE=
LOSAPUNTES_MOBILE_EAS_PROJECT_ID=
