NODE_ENV=development
# Deployment security posture: local | production.
# Production defaults to "production" when omitted.
DEPLOYMENT_PROFILE=local
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/losapuntes_legacy
WEB_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true

# Auth abuse-control HMAC key.
# Local/dev may use the documented isolated value. Production must inject a
# distinct high-entropy value through the secret-management mechanism.
AUTH_ABUSE_KEY_SECRET=losapuntes-local-auth-abuse-secret-2026

# Auth transactional email.
# Development may keep this disabled; production requires smtp.
AUTH_EMAIL_DELIVERY_MODE=disabled
AUTH_ACTION_BASE_URL=http://localhost:5173
AUTH_EMAIL_FROM=Los Apuntes <no-reply@example.test>
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=1025
AUTH_SMTP_SECURE=false
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=

# Google authentication is fail-safe disabled until fresh credentials exist.
GOOGLE_AUTH_ENABLED=false
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_WEB_CLIENT_SECRET=
# GOOGLE_WEB_REDIRECT_URI=http://localhost:4000/auth/google/web/callback
# GOOGLE_NATIVE_CLIENT_IDS=ios-client.apps.googleusercontent.com,android-client.apps.googleusercontent.com


# Reverse-proxy authority.
# Keep empty when the API is reached directly. When deployed behind ingress,
# list only the exact proxy IPs/CIDRs that are allowed to supply forwarded
# client-address headers. Hostnames, wildcards and named shortcuts are rejected.
# TRUSTED_PROXY_CIDRS=127.0.0.1,10.20.0.0/16

# Private S3-compatible Files storage.
FILES_STORAGE_PROVIDER=s3
FILES_S3_ENDPOINT=http://127.0.0.1:9000
FILES_S3_PUBLIC_ENDPOINT=http://localhost:9000
FILES_S3_REGION=us-east-1
FILES_S3_BUCKET=losapuntes-files
FILES_S3_ACCESS_KEY_ID=replace-me
FILES_S3_SECRET_ACCESS_KEY=replace-me
FILES_DOWNLOAD_URL_TTL_SECONDS=300
