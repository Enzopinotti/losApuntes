{
  "Rules": [
    {
      "ID": "account-export-abort-incomplete-multipart-after-7-days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "exports/"
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    },
    {
      "ID": "account-export-expire-after-8-days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "exports/"
      },
      "Expiration": {
        "Days": 8
      }
    }
  ]
}
