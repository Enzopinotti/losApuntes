{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountExportArtifactsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_ACCOUNT_EXPORT_BUCKET/exports/*"
    }
  ]
}
