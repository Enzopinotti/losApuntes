{
  "name": "los-apuntes",
  "private": true,
  "version": "0.0.0-reboot.0",
  "description": "Los Apuntes 2026 monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present check:types",
    "test": "pnpm --filter @losapuntes/api test:ci && pnpm test:web-auth-contract",
    "build": "pnpm -r --if-present build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "runtime:up": "docker compose -f compose.local.yml up --build -d --wait --wait-timeout 120",
    "runtime:smoke": "node scripts/smoke-api-runtime.mjs && node scripts/smoke-auth-lifecycle.mjs && node scripts/smoke-academic-lifecycle.mjs && node scripts/smoke-profile-lifecycle.mjs",
    "runtime:logs": "docker compose -f compose.local.yml logs --no-color",
    "runtime:down": "docker compose -f compose.local.yml down --volumes --remove-orphans",
    "check": "pnpm check:hygiene && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:web-auth-contract": "node scripts/test-web-auth-contract.mjs"
  }
}
