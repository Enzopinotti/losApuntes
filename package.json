{
  "name": "los-apuntes",
  "private": true,
  "version": "0.0.0-reboot.0",
  "description": "Los Apuntes 2026 monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present check:types",
    "test": "pnpm --filter @losapuntes/api test:ci && pnpm test:web-auth-contract && pnpm test:web-accessible-confirm-dialog-contract && pnpm test:web-async-authority-fence && pnpm test:notification-fanout-contract && pnpm test:web-academic-contract && pnpm test:web-profile-contract && pnpm test:web-resources-contract && pnpm test:web-search-contract && pnpm test:web-observability-contract && pnpm test:release-qualification-contract && pnpm test:release-qualification-live && pnpm test:web-social-qa-contract && pnpm test:web-feeds-contract && pnpm test:web-pilot-contract && pnpm test:web-organizations-contract && pnpm test:web-alumni-contract && pnpm --filter @losapuntes/mobile test && pnpm test:mobile-auth-contract && pnpm test:recovery-contract && pnpm test:resilience-contract && pnpm test:account-lifecycle-contract",
    "build": "pnpm -r --if-present build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "runtime:up": "docker compose -f compose.local.yml -f compose.health.yml up --build -d --wait --wait-timeout 120",
    "runtime:smoke": "node scripts/smoke-api-runtime.mjs && node scripts/smoke-auth-lifecycle.mjs && node scripts/smoke-academic-lifecycle.mjs && node scripts/smoke-profile-lifecycle.mjs && node scripts/smoke-files-resources-lifecycle.mjs && node scripts/smoke-search-discovery-lifecycle.mjs && node scripts/smoke-social-qa-lifecycle.mjs && node scripts/smoke-feeds-lifecycle.mjs && node scripts/smoke-pilot-lifecycle.mjs && node scripts/smoke-organizations-lifecycle.mjs && node scripts/smoke-alumni-lifecycle.mjs",
    "runtime:logs": "docker compose -f compose.local.yml -f compose.health.yml logs --no-color",
    "runtime:down": "docker compose -f compose.local.yml -f compose.health.yml down --volumes --remove-orphans",
    "check": "pnpm check:hygiene && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:web-auth-contract": "node scripts/test-web-auth-contract.mjs",
    "test:web-accessible-confirm-dialog-contract": "node scripts/test-web-accessible-confirm-dialog-contract.mjs",
    "test:web-async-authority-fence": "node --experimental-strip-types scripts/test-web-async-authority-fence.mjs",
    "test:web-profile-contract": "node scripts/test-web-profile-contract.mjs",
    "test:web-resources-contract": "node scripts/test-web-resources-contract.mjs",
    "test:web-search-contract": "node scripts/test-web-search-contract.mjs",
    "test:web-social-qa-contract": "node --experimental-strip-types scripts/test-web-social-qa-contract.mjs",
    "test:web-feeds-contract": "node scripts/test-web-feeds-contract.mjs",
    "test:web-pilot-contract": "node scripts/test-web-pilot-contract.mjs",
    "test:web-organizations-contract": "node scripts/test-web-organizations-contract.mjs",
    "test:web-alumni-contract": "node scripts/test-web-alumni-contract.mjs",
    "test:mobile-auth-contract": "node scripts/test-mobile-auth-contract.mjs",
    "recovery:backup": "node scripts/recovery/backup-set.mjs",
    "recovery:restore": "node scripts/recovery/restore-set.mjs",
    "recovery:check": "node scripts/recovery/check-recovery-point.mjs",
    "recovery:smoke-api": "node scripts/recovery/smoke-restored-api.mjs",
    "test:recovery-contract": "node --test scripts/recovery/recovery-lib.test.mjs && node scripts/test-recovery-contract.mjs",
    "test:web-academic-contract": "node scripts/test-web-academic-contract.mjs",
    "test:notification-fanout-contract": "node scripts/test-notification-fanout-contract.mjs",
    "resilience:check": "node scripts/resilience/check-evidence.mjs",
    "resilience:compose-env": "node scripts/resilience/render-compose-env.mjs",
    "test:resilience-contract": "node --test scripts/resilience/resilience-lib.test.mjs && node scripts/test-production-resilience-contract.mjs && pnpm security:audit-exceptions",
    "security:audit-exceptions": "node scripts/security/check-audit-exceptions.mjs",
    "test:account-lifecycle-contract": "node scripts/test-account-lifecycle-contract.mjs",
    "test:web-observability-contract": "node scripts/test-web-observability-contract.mjs",
    "test:release-qualification-contract": "node --experimental-strip-types scripts/test-release-qualification-contract.mjs",
    "release:qualify-live": "node scripts/release/qualify-live.mjs",
    "test:release-qualification-live": "node --test scripts/release/release-qualification-lib.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-fastify>fastify": "5.12.5"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-85393"
      ]
    }
  }
}
